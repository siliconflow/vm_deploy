# ===== 磁盘镜像 / 安装介质（体积大，不入库）=====
images/
*.qcow2
*.img
*.iso
*.part

# ===== cloud-init / 部署生成物（由脚本自动生成）=====
# WORK_DIR 若配置在仓库内时会产生的文件
user-data
meta-data
network-config
seed.iso

# ===== 虚拟机运行临时文件 =====
*.bak
*.xml.tmp

# ===== 脚本运行日志（体积可能持续增长，不入库）=====
logs/

# ===== 脚本生成物 / 断点续跑状态（由脚本自动生成，不入库）=====
output/
state/
tmp/

# ===== Python 编译缓存 / 下载缓存 =====
__pycache__/
cache/

# ===== 编辑器 / 系统垃圾 =====
.DS_Store
*.swp
.idea/
.vscode/
