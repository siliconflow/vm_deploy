# ============ VM 基础配置 ============
# VM 名称列表，数组长度决定部署台数
# MACHINE_NAMES=("machine1" "machine2" "machine3" "machine4" "machine5")
MACHINE_NAMES=("machine1" "machine2")

# 每台 VM 的 vCPU 数，与 MACHINE_NAMES 一一对应
# MACHINE_CPU=(5 5 2)
MACHINE_CPU=(5 5)

# 每台 VM 内存（MB），与 MACHINE_NAMES 一一对应
# MACHINE_MEM_MBS=(30720 30720 2048)
MACHINE_MEM_MBS=(30720 30720)

# 每台 VM 磁盘大小（GB，qcow2 精简置备），与 MACHINE_NAMES 一一对应
# DISK_GB=(50 50 20)
DISK_GB=(50 50)

# 每台 VM 的 MAC 地址，与 MACHINE_NAMES 一一对应
# MACHINE_MACS=("52:54:00:12:34:30" "52:54:00:12:34:31" "52:54:00:12:34:32" "52:54:00:12:34:33" "52:54:00:12:34:34")
MACHINE_MACS=("52:54:00:12:34:38" "52:54:00:12:34:39")

# 每台 VM 的静态 IP，与 MACHINE_NAMES 一一对应
# MACHINE_IPS=("192.168.122.40" "192.168.122.41" "192.168.122.42" "192.168.122.43" "192.168.122.44")
MACHINE_IPS=("192.168.122.38" "192.168.122.39"")

# 用于免密登录 VM 的 SSH 私钥
SSH_KEY="/root/.ssh/id_rsa"

# 本机 SSH 配置文件
SSH_CONFIG="/root/.ssh/config"

# ============ libvirt / cloud-init 路径 ============
# 磁盘镜像存放目录
POOL_DIR="/data/kvm/images"

# seed ISO、cloud-init 配置存放处
WORK_DIR="$POOL_DIR/seeds"

# ============ 网络配置 ============
# libvirt 默认 NAT 网段网关
NET_GW="192.168.122.1"

# 麒麟镜像配置
KYLIN_IMG_FILE=/data/vm_deploy/gen_qcow2/output_qcow2/kylin-v10-base.qcow2
