# auto_sync.py 配置文件
# 提交信息前缀，未通过 -m 指定时使用
AUTO_COMMIT_PREFIX=auto sync

# 远程仓库名称
REMOTE_NAME=origin

# 指定拉取分支，留空时使用当前分支的上游配置
DEFAULT_BRANCH=

# 是否允许无变更时创建空提交：true/false
ALLOW_EMPTY_COMMIT=false

# Git 提交身份，仓库未配置 user.name / user.email 时自动全局设置
GIT_USER_NAME=renshan
GIT_USER_EMAIL=bjhanjf@qq.com

# 单文件大小上限（MB），Gitee 限制 100MB，超过会拒绝推送。默认 100
LARGE_FILE_LIMIT_MB=100

# 是否在推送前自动从未推送历史中剥离超限大文件：true/false
AUTO_STRIP_LARGE_FILES=true
