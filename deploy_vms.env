# ============ VM 基础配置 ============
# 是否部署 VIP 机（1=部署，0=不部署，默认 1）
# 设为 0 时总台数 = WORKER_COUNT（全部为普通机），宿主机资源只在普通机之间按份额均分
# 注意：设为 0 后 destroy 只处理普通机；如需清理此前已部署的 VIP 机，先改回 1 再执行 destroy
DEPLOY_VIP=0

# 普通 VM 台数（正整数）。DEPLOY_VIP=1 时实际部署台数 = 台数 + 1（额外固定 1 台 VIP 机）
# 例：填 3 实际部署 4 台（3 普通 + 1 VIP）；DEPLOY_VIP=0 时填 3 只部署 3 台
WORKER_COUNT=1

# ============ 普通 VM 规格（每项只填一个值，VIP 机的各项资源自动按比例缩放） ============

# 普通 VM 与 VIP 机的资源比例（格式 普通机份额:VIP机份额，支持小数，默认 2:1）
# CPU/内存按此比例分摊宿主机资源，系数之和恒为 1（正好用满不超分）；磁盘/swap 按此比例反向缩放
# 例：填 3 台 + 比例 2:1 → 共 4 台分 7 份，普通机各占 2/7、VIP 机占 1/7；2.5:1 表示普通机 CPU/内存是 VIP 机的 2.5 倍
# 注意：磁盘/swap 与比例反向——VIP 机磁盘 = DISK_GB × (普通份额/VIP份额)，比例越大 VIP 机磁盘/swap 反而越大
# 例：2 台 + 比例 2.5:1 + 磁盘 100G → 普通机各 100G，VIP 机 250G（swap 同理 16G → 40G）
RESOURCE_RATIO="4:1"

# 普通 VM 磁盘大小（GB，qcow2 精简置备）
DISK_GB=80

# 普通 VM 的 swap 大小（GB，在虚机内创建 /swapfile，不占宿主机内存）；0=不创建
MACHINE_SWAP_GB=16

# 自动分配的 IP 起始地址，往后顺序递增（避开网关，默认 192.168.122.10）
IP_START="192.168.122.10"

# 起始机器名（默认 machine1）：机器名从它起统一编号排列，VIP 机为最后一台；
# 前缀可自定义（如 node5 → node5、node6、node7...），宿主机上已有同名 VM 时可换前缀或调大编号
MACHINE_NAME_START="machine1"

# ============ 以下参数全部自动生成，无需配置 ============
# 机器名：按上面起始机器名统一编号排列（VIP 机为最后一台）
# MAC：随机生成（52:54:00 前缀，自动去重；重复部署自动复用上次记录的 MAC）

# 每类镜像默认登录用户（可覆盖，示例把 Ubuntu 也改为 root）
# Ubuntu 云镜像默认用户为 ubuntu；设为 root 后将以 root 免密登录
UBUNTU_IMAGE_USER=root
# 麒麟默认 root，一般无需改动
# KYLIN_IMAGE_USER=root

# 用于免密登录 VM 的 SSH 私钥
SSH_KEY="/root/.ssh/id_rsa"

# 本机 SSH 配置文件
SSH_CONFIG="/root/.ssh/config"

# ============ libvirt / cloud-init 路径 ============
# 下载的基础镜像（ubuntu/kylin qcow2）存放目录，随项目目录存放便于整体迁移
IMG_DIR="/data/vm_deploy/images"

# VM 磁盘镜像存放目录
POOL_DIR="/data/kvm/images"

# seed ISO、cloud-init 配置存放处
WORK_DIR="$POOL_DIR/seeds"

# ============ 网络配置 ============
# libvirt 默认 NAT 网段网关
NET_GW="192.168.122.1"

# 麒麟镜像配置
KYLIN_IMG_FILE=/data/vm_deploy/gen_qcow2/output_qcow2/Kylin-Server-V10-SP3-2403-Release-20240426-X86_64.qcow2

# ============================================================
# ============ macOS (Lima) 配置段 ============
# 本段仅供 macOS 平台使用：deploy_vms.sh 在 Darwin 上自动走内置的
# Lima 实现，并读取本段配置；Linux 平台忽略本段。
# 机器配置模型与 Linux 段一致：WORKER_COUNT + DEPLOY_VIP + RESOURCE_RATIO + DISK_GB +
# MACHINE_NAME_START（共用上方"VM 基础配置"段的值）自动生成机器名/CPU/内存/
# 磁盘/SSH 端口，本段只放 macOS 专属配置。
# ============================================================

# 第 1 台 VM 的 SSH 转发端口，后续每台递增 1（如 60001 → machine1=60001, machine2=60002...）
# 固定端口后 `ssh machine1` 别名在 VM 重启后依然有效
BASE_SSH_PORT=60001

# 为 macOS 系统本身保留的内存（GiB）。VM 内存总量按"宿主机内存 - 该值"分摊，
# 避免把整机内存全部分给 VM 导致宿主机内存压力过大、VM 启动极慢
HOST_MEM_RESERVE_GB=4

# limactl start 等待 VM 就绪的超时时间（如 10m / 20m）。首启较慢的系统镜像可调大
LIMA_START_TIMEOUT="20m"

# 虚拟化引擎类型（macOS 上推荐 vz，要求 macOS 13+）
VM_TYPE="vz"

# VM 时区
TIMEZONE="Asia/Shanghai"

# ============ 镜像配置（macOS） ============
# 麒麟 V10 本地 aarch64 云镜像路径（部署 kylin-v10 时必须存在，官方公开下载仅 x86_64，
# 请从麒麟官方/授权渠道获取 aarch64 qcow2 云镜像后填到这里）
MAC_KYLIN_IMG_FILE="$HOME/Downloads/kylin-v10-aarch64.qcow2"

# 麒麟 V10 可选下载地址（为空则不尝试下载，仅使用本地镜像 MAC_KYLIN_IMG_FILE）
KYLIN_IMG_URL=""

# ============ SSH 登录用户（macOS） ============
# SSH 别名登录 VM 的用户（默认 root）。云镜像默认禁用 root，脚本会在部署后
# 自动将 Lima 密钥写入 root 并放开 PermitRootLogin prohibit-password（仅密钥登录）。
# 改回初始化用户可设为 ubuntu（Ubuntu）/ kylin（麒麟）
SSH_USER="root"
