# ============================================================================
# manage_vms.env — manage_vms.sh 配置文件
#
# manage_vms.sh（批量启动/停止 VM）所需的 VM 清单与 SSH 端口等配置，
# 与部署脚本（deploy_vms.sh）完全共用，统一在 deploy_vms.env 中维护，
# 本文件仅负责引入，避免两处配置不一致。
#
# 如需调整 VM 名称/台数/SSH 端口，请编辑 deploy_vms.env 的 macOS (Lima) 配置段。
# ============================================================================
# shellcheck shell=bash
MANAGE_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$MANAGE_ENV_DIR/deploy_vms.env"
